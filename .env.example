# Copy file này thành .env và điền giá trị thật
# KHÔNG commit file .env vào git

# ── PostgreSQL ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mijil
DB_USER=mijil
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# ── Backend ──────────────────────────────────────
NODE_ENV=production

# ── Malware Analyzer (BẮT BUỘC) ──────────────────
# Sinh bằng: python -c "import secrets; print(secrets.token_hex(32))"
MALWARE_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

# Token để protect endpoint /analyze (để trống = public)
ANALYZE_AUTH_TOKEN=

# Rate limit: số request tối đa mỗi IP mỗi phút (0 = không giới hạn)
ANALYZE_RATE_LIMIT_PER_MINUTE=30

# Cho phép upload không cần token (true/false)
ALLOW_PUBLIC_UPLOADS=false

# ── API Tình báo Mối đe dọa (Tùy chọn) ──────────
VT_API_KEY=
OTX_API_KEY=

# ── Trình phân loại ML (Tùy chọn) ─────────────────────
# VT_POSITIVE_THRESHOLD=10        # số engine detect tối thiểu để coi là malware
# ML_MIN_SAMPLES_FIRST_TRAIN=50   # số samples cần để train lần đầu
# ML_MIN_NEW_SAMPLES_RETRAIN=25   # số samples mới cần để retrain

# ── Cơ sở dữ liệu Đồ thị Neo4j (Tùy chọn) ────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
